# --- Database -----------------------------------------------------------
# Pooled connection (application runtime) and direct connection (migrations).
DATABASE_URL="postgresql://USER:PASSWORD@ep-XXX-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-XXX.us-east-1.aws.neon.tech/neondb?sslmode=require"

# --- Object storage (Neon S3-compatible) ---------------------------------
# Product artwork admins upload lives under products/ in this bucket and is
# served back by /api/assets. Leave unset to keep the seeded local images.
# Generate a key in the Neon dashboard: Storage > your project > Connect.
AWS_ENDPOINT_URL_S3="https://XXX.storage.us-east-2.aws.neon.tech"
AWS_ACCESS_KEY_ID="nak_live_XXX"
AWS_SECRET_ACCESS_KEY="nsk_live_XXX"
AWS_REGION="us-east-2"
S3_BUCKET="assets"

# --- App ----------------------------------------------------------------
# Absolute public origin, used for gateway callback and return URLs.
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Base currency of the ledger. priceCents are integer minor units of this code.
BASE_CURRENCY="ETB"
BASE_COUNTRY="Ethiopia"

# --- Which gateways are offered, in display order ----------------------
PAYMENT_PROVIDERS="CHAPA,STRIPE"

# --- Chapa (Ethiopian rails: telebirr, CBE Birr, local cards) ----------
# Test secret keys come from Chapa > Developers > Secret Key (Test).
CHAPA_SECRET_KEY=""
CHAPA_PUBLIC_KEY=""
# Dashboard > Developers > Webhook hash public key, used to verify X-Chapa-Signature.
CHAPA_WEBHOOK_HASH_PUBLIC_KEY=""
# v1 is the documented default. Point this at a newer base (e.g. https://api.chapa.et/v3)
# to switch checkout generations without touching code.
CHAPA_BASE_URL="https://api.chapa.co/v1"

# --- Stripe (test mode) -------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Stripe must support this currency on your account.
STRIPE_CURRENCY="usd"
# Required when STRIPE_CURRENCY differs from BASE_CURRENCY: how many ETB buy 1 USD.
# Conversion happens once, at the Stripe boundary; the ledger stays in BASE_CURRENCY.
ETB_PER_USD=""

# --- Demo provider ------------------------------------------------------
# true enables the "Demo payment" option, which completes orders with no charge.
DEMO_PAYMENTS="false"

# --- Scheduled reconciliation ------------------------------------------
# Bearer token for /api/cron/reconcile (Vercel Cron sends it automatically).
CRON_SECRET=""

# --- Seed -----------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-please"
